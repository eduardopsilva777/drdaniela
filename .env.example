# =============================================================================
# CRM Dra. Daniela Zilioli — variáveis de ambiente
# Copie para `.env` (desenvolvimento) e ajuste. NUNCA versione o `.env` real.
# Em produção, configure estas variáveis no provedor de hospedagem.
# =============================================================================

# --- Banco de dados (PostgreSQL) ---------------------------------------------
# Valores abaixo correspondem ao docker-compose.yml (somente desenvolvimento).
DATABASE_URL="postgresql://crm:crm_dev_password@localhost:5432/crm_dev?schema=public"

# Banco exclusivo dos testes de integração. Os testes APAGAM os dados deste banco,
# por isso ele precisa ser diferente de DATABASE_URL.
TEST_DATABASE_URL="postgresql://crm:crm_dev_password@localhost:5432/crm_test?schema=public"

# --- Aplicação ---------------------------------------------------------------
# URL pública da aplicação (sem barra no final).
APP_URL="http://localhost:3000"
# Fuso horário usado na agenda e nos lembretes.
APP_TIMEZONE="America/Sao_Paulo"
# Nível de log: debug | info | warn | error
LOG_LEVEL="info"

# --- Sessão e segurança ------------------------------------------------------
# Duração máxima de uma sessão (horas) — após isso é exigido novo login.
SESSION_MAX_AGE_HOURS=12
# Encerra a sessão após este tempo sem atividade (minutos).
SESSION_IDLE_TIMEOUT_MINUTES=120
# Defina "true" apenas se a aplicação estiver atrás de um proxy reverso confiável
# que sobrescreve o cabeçalho X-Forwarded-For (usado em auditoria e limite de tentativas).
TRUST_PROXY="false"

# Produção com múltiplas instâncias: chave estável para cifrar referências de
# Server Actions (gere com: openssl rand -base64 32).
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# --- Seed (somente desenvolvimento) -------------------------------------------
# Senha atribuída aos usuários FICTÍCIOS criados por `npm run db:seed`.
# O seed se recusa a rodar com NODE_ENV=production.
SEED_USER_PASSWORD="senha-dev-somente-local"

# --- Proteção de dados -------------------------------------------------------
# Chave AES-256 que cifra as observações dos pacientes (32 bytes em base64).
# Gere com: openssl rand -base64 32   (ou: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# GUARDE COM SEGURANÇA: sem ela, as observações já gravadas não podem ser lidas.
DATA_ENCRYPTION_KEY=""
# Somente durante uma rotação de chave: a chave ANTERIOR, aceita apenas na leitura.
# Procedimento em docs/operacao.md (npm run data:rotate-key). Remova ao concluir.
DATA_ENCRYPTION_KEY_PREVIOUS=""

# --- Lembretes ------------------------------------------------------------------
# Segredo exigido pelo endpoint POST /api/jobs/reminders (agendador/cron).
# Gere com: openssl rand -base64 32
CRON_SECRET=""
# Antecedência dos lembretes de retorno (dias) e de agendamento (horas).
REMINDER_RETURN_DAYS_BEFORE=2
REMINDER_APPOINTMENT_HOURS_BEFORE=24

# --- WhatsApp Business ------------------------------------------------------------
# disabled    → nada é enviado; lembretes ficam registrados no CRM (padrão em produção)
# development → mensagens ficam só no banco, marcadas como SIMULADAS (padrão fora de produção)
# cloud_api   → envio real pela API oficial (exige as credenciais abaixo)
WHATSAPP_PROVIDER="development"
WHATSAPP_GRAPH_API_VERSION="v23.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
# Segredo do app Meta: valida a assinatura X-Hub-Signature-256 dos webhooks.
WHATSAPP_APP_SECRET=""
# Token definido por você e informado no painel da Meta na verificação do webhook.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# Modelos (templates) aprovados na Meta para mensagens iniciadas pela clínica.
WHATSAPP_TEMPLATE_LANGUAGE="pt_BR"
WHATSAPP_TEMPLATE_RETURN_REMINDER=""
WHATSAPP_TEMPLATE_APPOINTMENT_REMINDER=""
